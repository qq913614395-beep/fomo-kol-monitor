PORT=8788
DATA_DIR=/var/lib/fomo-kol-monitor
DATABASE_PATH=/var/lib/fomo-kol-monitor/monitor.sqlite3
INSTANCE_LOCK_PATH=/var/lib/fomo-kol-monitor/monitor.lock
LEGACY_STATE_PATH=/var/lib/fomo-kol-monitor/state.json

# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MONITOR_MASTER_KEY=
PUBLIC_BASE_URL=https://radar.example.com
ALLOWED_ORIGINS=https://radar.example.com
TRUSTED_HOSTS=radar.example.com

BACKFILL_ON_FIRST_RUN=false
ENABLE_TOKEN_ENRICHMENT=true
ENABLE_RPC_WEBSOCKET=true
ENABLE_FOMOSCAN_RESOLVER=false

SOLANA_RPC_HTTP=
SOLANA_RPC_WS=
BASE_RPC_HTTP=
BASE_RPC_FALLBACK_HTTP=
BASE_RPC_WS=
BNB_RPC_HTTP=
BNB_RPC_FALLBACK_HTTP=
BNB_RPC_WS=
ETH_RPC_HTTP=
ETH_RPC_FALLBACK_HTTP=
ETH_RPC_WS=

RPC_CONCURRENCY=16
RELAY_CONCURRENCY=4
GMGN_CLI_PATH=/usr/local/bin/gmgn-cli
GMGN_CHAINS=sol,bsc,base,eth
GMGN_POLL_INTERVAL_MS=5000
GMGN_CONCURRENCY=16
GMGN_REQUESTS_PER_SECOND=20
GMGN_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
