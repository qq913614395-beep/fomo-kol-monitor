# Local dashboard/API
PORT=8788
WEB_PORT=3001
POLL_INTERVAL_MS=2500
EVM_POLL_INTERVAL_MS=2500
RELAY_POLL_INTERVAL_MS=4000
SOLANA_PAGE_SIZE=20
SOLANA_MAX_PAGES=5
EVM_MAX_BLOCK_RANGE=50
EVM_MAX_CATCHUP_BLOCKS=200
RELAY_PAGE_SIZE=25
RPC_CONCURRENCY=8
RELAY_CONCURRENCY=4
BACKFILL_ON_FIRST_RUN=false
DATA_DIR=./data

# Public RPC defaults are suitable only for a small trial. Replace them with
# paid/private endpoints before monitoring many accounts.
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=
BASE_RPC_HTTP=https://base-rpc.publicnode.com
BASE_RPC_FALLBACK_HTTP=https://mainnet.base.org
BASE_RPC_WS=
BNB_RPC_HTTP=https://bsc-rpc.publicnode.com
BNB_RPC_FALLBACK_HTTP=https://bsc-dataseed.binance.org
BNB_RPC_WS=

# WebSocket is the primary low-latency path. When a WS URL is blank the
# monitor derives ws:// or wss:// from the matching HTTP URL, then keeps HTTP
# polling active as a disconnect/backfill safety net.
ENABLE_RPC_WEBSOCKET=true
SUBSCRIPTION_REFRESH_MS=15000
EVM_ENTRYPOINT_ADDRESSES=0x4337084d9e255ff0702461cf8895ce9e3b5ff108,0x0000000071727de22e5e9d8baf0edac6f37da032

# Relay v2 is public but deprecated. Set a v3 path/key when provisioned.
RELAY_API_BASE=https://api.relay.link
RELAY_REQUESTS_PATH=/requests/v2
RELAY_API_KEY=

# Exact per-wallet GMGN portfolio activity. Imported wallets do not need to be
# followed by the GMGN account; each configured address is queried directly.
ENABLE_GMGN=true
GMGN_CLI_PATH=
GMGN_CHAINS=sol,bsc,base,eth
GMGN_POLL_INTERVAL_MS=5000
GMGN_COMMAND_TIMEOUT_MS=15000
GMGN_LIMIT=100
GMGN_MAX_PAGES=4
GMGN_LOOKBACK_SECONDS=600
GMGN_CONCURRENCY=4
GMGN_REQUESTS_PER_SECOND=8

# Required on Linux/server deployments. Generate a 32-byte base64url key.
# Windows uses DPAPI when this is blank.
MONITOR_MASTER_KEY=
PUBLIC_BASE_URL=
TRUSTED_HOSTS=

# Optional push channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# Public third-party seed resolver. Relay evidence is still required before a
# discovered address is marked verified.
ENABLE_FOMOSCAN_RESOLVER=true

# Token symbol, USD price, market cap and liquidity enrichment.
ENABLE_TOKEN_ENRICHMENT=true
DEXSCREENER_API_BASE=https://api.dexscreener.com
TOKEN_CACHE_TTL_MS=60000
